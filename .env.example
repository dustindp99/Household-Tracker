# Copy to .env.local. For local development, get both values from `npx supabase status`.
# On a physical phone, replace 127.0.0.1 with this computer's LAN IP address.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the website that serves invite links, e.g. https://example.com
EXPO_PUBLIC_INVITE_BASE_URL=
